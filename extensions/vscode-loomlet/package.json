{
  "name": "loomlet-vscode",
  "displayName": "Loomlet",
  "description": "VS Code support for Loomlet language files and Scene Sync workflows",
  "version": "0.0.1",
  "publisher": "afjk",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:loomlet",
    "onCommand:loomlet.runCurrentFile",
    "onCommand:loomlet.sceneSyncDevCurrentFile",
    "onCommand:loomlet.openNodePreviewToSide"
  ],
  "contributes": {
    "languages": [
      {
        "id": "loomlet",
        "aliases": [
          "Loomlet",
          "Loom"
        ],
        "extensions": [
          ".loom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loomlet",
        "scopeName": "source.loomlet",
        "path": "./syntaxes/loom.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "loomlet.runCurrentFile",
        "title": "Loomlet: Run Current File"
      },
      {
        "command": "loomlet.sceneSyncDevCurrentFile",
        "title": "Loomlet: Scene Sync Dev Current File"
      },
      {
        "command": "loomlet.openNodePreviewToSide",
        "title": "Loomlet: Open Node Preview to the Side"
      }
    ],
    "configuration": {
      "title": "Loomlet",
      "properties": {
        "loomlet.completion.includePlanned": {
          "type": "boolean",
          "default": false,
          "description": "Include planned Loomlet libraries/functions in completion suggestions."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/completion-context.test.mjs && node test/completion-engine.test.mjs"
  }
}
