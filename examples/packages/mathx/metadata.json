{
  "mathx": {
    "name": "mathx",
    "description": "Example user-authored math helpers (clamp, lerp).",
    "targets": ["cli", "web", "scenesync"],
    "functions": {
      "clamp": {
        "name": "clamp",
        "signature": "mathx.clamp(value, min: 0, max: 1)",
        "description": "Constrains value to the [min, max] range.",
        "args": [
          { "name": "value", "type": "number", "positional": true, "description": "Value to constrain." },
          { "name": "min", "type": "number", "positional": false, "description": "Lower bound." },
          { "name": "max", "type": "number", "positional": false, "description": "Upper bound." }
        ],
        "returns": "number",
        "targets": ["cli", "web", "scenesync"],
        "examples": ["result = mathx.clamp(1.5, min: 0, max: 1)"]
      },
      "lerp": {
        "name": "lerp",
        "signature": "mathx.lerp(a, b: 1, t: 0)",
        "description": "Linear interpolation between a and b by t in [0, 1].",
        "args": [
          { "name": "a", "type": "number", "positional": true, "description": "Start value." },
          { "name": "b", "type": "number", "positional": false, "description": "End value." },
          { "name": "t", "type": "number", "positional": false, "description": "Interpolation factor in [0, 1]." }
        ],
        "returns": "number",
        "targets": ["cli", "web", "scenesync"],
        "examples": ["result = mathx.lerp(0, b: 100, t: 0.25)"]
      }
    }
  }
}
