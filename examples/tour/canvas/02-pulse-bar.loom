# Tour: Pulse Bar
# Goal: Animate a bar's width and vertical position together.
# Status: runnable
# Run:
#   loomlet run examples/tour/canvas/02-pulse-bar.loom --time 0.5
# Requires:
#   - clock / sine / map
#   - render bar

t = clock()
wave = sine(t, freq: 1.2)
width = map(wave, inMin: -1, inMax: 1, outMin: 20, outMax: 360)
y = map(wave, inMin: -1, inMax: 1, outMin: 100, outMax: 180)

render bar(width: width, y: y, height: 32, color: "#ffd166")
