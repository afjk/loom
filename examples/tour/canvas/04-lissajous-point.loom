# Tour: Lissajous Point
# Goal: Trace a looping Lissajous path with two different frequencies.
# Status: runnable
# Run:
#   loomlet run examples/tour/canvas/04-lissajous-point.loom --time 0.5
# Requires:
#   - clock / sine / cosine / map
#   - render point

t = clock()
xWave = sine(t, freq: 0.7)
yWave = cosine(t, freq: 1.1)

x = map(xWave, inMin: -1, inMax: 1, outMin: 60, outMax: 360)
y = map(yWave, inMin: -1, inMax: 1, outMin: 60, outMax: 260)

render point(x: x, y: y, color: "#70d6ff", trail: 0.04)
