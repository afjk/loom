# Tour: Orbit Point
# Goal: Move a canvas point in a circle from sine/cosine.
# Status: runnable
# Run:
#   loomlet run examples/tour/canvas/03-orbit-point.loom --time 0.5
# Requires:
#   - clock / sine / cosine / map
#   - render point

t = clock()
xWave = sine(t, freq: 0.4)
yWave = cosine(t, freq: 0.4)

x = map(xWave, inMin: -1, inMax: 1, outMin: 80, outMax: 320)
y = map(yWave, inMin: -1, inMax: 1, outMin: 80, outMax: 240)

render point(x: x, y: y, color: "#ff70a6", trail: 0.08)
