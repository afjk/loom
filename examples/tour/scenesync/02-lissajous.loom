# Tour: Lissajous
# Goal: Two-axis oscillation with different frequencies.
# Status: runnable
# Run:
#   loomlet scenesync dev examples/tour/scenesync/02-lissajous.loom
# Setup:
#   - Open a Scene Sync room.
#   - Link Loomlet with `loomlet scenesync redeem <code> --save`.
#   - Ensure an object named `lissajous-target` exists in the scene.
# Requires:
#   - clock (host-provided time)
#   - math.sine
#   - scene.setPosition
import math
import scene

t = clock()
x = math.sine(t, freq: 0.2, amplitude: 2, offset: 0)
y = math.sine(t, freq: 0.3, amplitude: 0.5, offset: 1.2)

scene.setPosition(objectId: "lissajous-target", x: x, y: y, z: 0)
