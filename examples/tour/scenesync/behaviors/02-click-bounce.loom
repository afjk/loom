# Tour: Click Bounce
# Goal: Nudge an object upward on each click, then let it settle back.
# Status: manual-runnable
# Run:
#   loomlet scenesync dev examples/tour/scenesync/behaviors/02-click-bounce.loom
# Setup:
#   - Open a Scene Sync room and link Loomlet (`loomlet scenesync redeem <code> --save`).
#   - Attach this behavior to an object; click it in the scene.
# Note:
#   - Same click->flash idiom as 01-click-color, mapped to a vertical offset.
# Requires:
#   - onEvent, list.length, logic.*, math.multiply, integrate, scene.offsetPosition
import scene
import logic
import list
import math

click = onEvent(channel: "pointer.click")
clickCount = list.length(list: click)
clicked = logic.greaterThan(value: clickCount, other: 0)

drive = logic.select(condition: clicked, whenTrue: 60, whenFalse: -3)
bounce = integrate(value: drive, initial: 0, min: 0, max: 1)
dy = math.multiply(a: bounce, b: 0.8)

scene.offsetPosition(y: dy)
