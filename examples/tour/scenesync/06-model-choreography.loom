# Tour: Model Choreography
# Goal: Multi-parameter choreography.
# Status: runnable
import math
import scene

t = clock()
x = math.sine(t, freq: 0.3, amplitude: 1.0)
y = math.cosine(t, freq: 0.4, amplitude: 0.5)
z = math.sine(t, freq: 0.2, amplitude: 1.5)

scene.setPosition(objectId: "model-target", x: x, y: y, z: z)
