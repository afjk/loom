# Tour: Conditions
# Goal: Value selection with logic nodes.
# Status: runnable
# Run:
#   loomlet run examples/tour/language/05-conditions.loom
# Requires:
#   - logic.equals
#   - logic.select
#   - console.log

import logic
import console

n = constant(value: 3)
isThree = logic.equals(n, other: 3)
label = logic.select(isThree, whenTrue: "three", whenFalse: "other")

console.log(label)
